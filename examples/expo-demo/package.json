    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.24",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-nitro-image": "0.15.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-vision-camera": "5.0.11"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
